# Optional root .env; loaded by the server and Vite.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Server-managed files are relative to the repository root unless absolute.
DATA_DIR=data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
IDLE_TIMEOUT_SECONDS=90

# Local inference only; run Ollama separately with OLLAMA_NO_CLOUD=1.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
PLANNER_TIMEOUT_SECONDS=45
EVENT_SKIP_PROBABILITY=0.25
EVENT_DELAY_SCALE=1
ASSET_REUSE_THRESHOLD=0.75
# Optional EVENT_DELAY_BUCKETS is a JSON array with weight/minimumSeconds/maximumSeconds.

# Development only. Must match PORT unless using a different local API.
API_PROXY_TARGET=http://127.0.0.1:3000

# Local sound worker; run the one-time setup documented in README.
SOUND_ENABLED=true
SOUND_PYTHON=models/sound-runtime/bin/python
# Apple Silicon: Medium via MLX. Use small-sfx + cpu for the original model.
SOUND_MODEL=medium
SOUND_DEVICE=mlx
# SOUND_MODEL_MANIFEST=...  # Optional override; normally derived from model/device.
SOUND_TIMEOUT_SECONDS=300
SOUND_IDLE_UNLOAD_SECONDS=1800
# HF_TOKEN=...  # Setup only; never use VITE_HF_TOKEN or commit a token.
