{
  "name": "@soundscapes/server",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "fixture:create": "node --import tsx src/cli/create-fixture.ts",
    "audio:smoke": "node --import tsx src/cli/audio-smoke.ts",
    "audio:integration": "node --import tsx src/cli/audio-integration.ts",
    "dev": "tsx watch --include '../../packages/shared/dist/**/*.js' src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js --serve-web",
    "typecheck": "tsc --noEmit",
    "ambience:create": "node --import tsx src/cli/create-ambience.ts",
    "audio:phase2": "node --import tsx src/cli/audio-integration.ts --ambience",
    "audio:mixer": "node --import tsx src/cli/mixer-smoke.ts",
    "soak:record": "node --import tsx src/cli/soak-record.ts",
    "event:import": "node --import tsx src/cli/import-event.ts",
    "planner:smoke": "node --import tsx src/cli/planner-smoke.ts",
    "audio:phase3": "node --import tsx src/cli/phase3-smoke.ts",
    "event:fixture": "node --import tsx src/cli/create-event-fixture.ts",
    "sound:setup": "node --import tsx src/cli/sound-setup.ts",
    "sound:smoke": "node --import tsx src/cli/sound-smoke.ts",
    "audio:phase4": "node --import tsx src/cli/phase4-smoke.ts",
    "lan:smoke": "node --import tsx src/cli/https-smoke.ts",
    "audio:level": "node --import tsx src/cli/level-smoke.ts",
    "acceptance:run": "node --import tsx src/cli/acceptance.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@soundscapes/shared": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
