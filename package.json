{
  "name": "soundscapes",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "fixture:create": "pnpm --filter @soundscapes/server fixture:create",
    "audio:smoke": "pnpm --filter @soundscapes/server audio:smoke",
    "audio:integration": "pnpm --filter @soundscapes/server audio:integration",
    "dev": "pnpm --filter @soundscapes/shared build && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @soundscapes/server start",
    "lint": "pnpm --filter @soundscapes/shared build && xo",
    "lint:fix": "pnpm --filter @soundscapes/shared build && xo --fix",
    "typecheck": "pnpm --filter @soundscapes/shared build && pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm --filter @soundscapes/shared build && vitest run",
    "test:watch": "pnpm --filter @soundscapes/shared build && vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ambience:create": "pnpm --filter @soundscapes/server ambience:create",
    "audio:phase2": "pnpm --filter @soundscapes/server audio:phase2",
    "audio:mixer": "pnpm --filter @soundscapes/server audio:mixer",
    "soak:record": "pnpm --filter @soundscapes/server soak:record",
    "event:import": "pnpm --filter @soundscapes/server event:import",
    "planner:smoke": "pnpm --filter @soundscapes/server planner:smoke",
    "audio:phase3": "pnpm --filter @soundscapes/server audio:phase3",
    "event:fixture": "pnpm --filter @soundscapes/server event:fixture",
    "sound:setup": "pnpm --filter @soundscapes/server sound:setup",
    "sound:smoke": "pnpm --filter @soundscapes/server sound:smoke",
    "audio:phase4": "pnpm --filter @soundscapes/server audio:phase4",
    "lan:smoke": "pnpm --filter @soundscapes/server lan:smoke",
    "audio:level": "pnpm --filter @soundscapes/server audio:level && pnpm --filter @soundscapes/server audio:level --pcm",
    "acceptance:run": "pnpm --filter @soundscapes/server acceptance:run",
    "audio:layers": "pnpm --filter @soundscapes/server audio:layers"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "xo": "~1.2.0"
  }
}
